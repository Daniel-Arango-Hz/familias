{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/descargar/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/guardar/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/seguir/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/registro/?$",
			"dest": "_render"
		},
		{
			"src": "^/autores/?$",
			"dest": "_render"
		},
		{
			"src": "^/biblioteca/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/galeria/?$",
			"dest": "_render"
		},
		{
			"src": "^/galeria-familiar/?$",
			"dest": "_render"
		},
		{
			"src": "^/libro/([^/]+?)/leer/?$",
			"dest": "_render"
		},
		{
			"src": "^/panel/guardados/?$",
			"dest": "_render"
		},
		{
			"src": "^/panel/publicaciones/?$",
			"dest": "_render"
		},
		{
			"src": "^/panel/?$",
			"dest": "_render"
		},
		{
			"src": "^/perfil/?$",
			"dest": "_render"
		},
		{
			"src": "^/recursos/?$",
			"dest": "_render"
		},
		{
			"src": "^/subir-libro/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}