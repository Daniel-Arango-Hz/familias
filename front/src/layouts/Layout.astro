---
import LoginModal from '../components/LoginModal.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "FamiliaLee – Biblioteca Digital Cristiana para Familias",
  description = "Libros, cuentos, guías y recursos educativos creados por autores y familias para fortalecer la fe en el hogar.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <LoginModal />
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    /* Colores vibrantes y amigables para niños */
    --color-navy: #2c3e7f;
    --color-navy-light: #4a63d6;
    --color-gold: #ff9f1c;
    --color-gold-light: #ffc857;
    --color-cream: #fff5e6;
    --color-cream-dark: #ffe8cc;
    
    /* Colores adicionales para niños */
    --color-primary-blue: #00a8e8;
    --color-primary-pink: #ff006e;
    --color-primary-green: #06a77d;
    --color-primary-purple: #b82db5;
    --color-primary-red: #ff4757;
    --color-primary-yellow: #ffd93d;
    
    --color-text: #1a2332;
    --color-text-muted: #6b7a8b;
    --color-white: #ffffff;
    --color-border: #e0e0e0;
    
    --radius-sm: 12px;
    --radius-md: 16px;
    --radius-lg: 24px;
    --shadow-sm: 0 2px 8px rgba(0,0,0,0.1);
    --shadow-md: 0 8px 16px rgba(0,0,0,0.12);
    --shadow-lg: 0 12px 24px rgba(0,0,0,0.15);
    --font-serif: 'Lora', Georgia, serif;
    --font-sans: 'Inter', system-ui, sans-serif;
    --max-width: 1200px;
  }

  html {
    font-family: var(--font-sans);
    color: var(--color-text);
    background-color: var(--color-white);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    cursor: pointer;
    font-family: var(--font-sans);
    border: none;
    background: none;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 5rem 0;
  }

  .section-bg {
    background-color: var(--color-cream);
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-header h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 0.35rem;
  }

  .section-header p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .section-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ver-mas {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-navy);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transition: opacity 0.2s;
    padding-top: 0.25rem;
  }

  .ver-mas:hover {
    opacity: 0.7;
  }

  .badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 500;
    background-color: var(--color-cream-dark);
    color: var(--color-text-muted);
  }

  .badge-destacado {
    background-color: var(--color-gold);
    color: var(--color-white);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
  }

  .star-rating {
    color: var(--color-gold);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .star-rating span {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  /* Mobile Optimizations */
  @media (max-width: 768px) {
    :root {
      --radius-sm: 10px;
      --radius-md: 14px;
      --radius-lg: 20px;
    }

    html {
      font-size: 15px;
    }

    .container {
      padding: 0 1.25rem;
    }

    .section {
      padding: 3.5rem 0;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .section-header h2 {
      font-size: clamp(1.5rem, 2.5vw, 1.95rem);
      margin-bottom: 0.3rem;
    }

    .section-header p {
      font-size: 0.9rem;
    }

    .section-header-row {
      gap: 0.75rem;
    }

    .ver-mas {
      font-size: 0.85rem;
    }

    .badge {
      padding: 0.18rem 0.5rem;
      font-size: 0.72rem;
    }

    .badge-destacado {
      padding: 0.22rem 0.65rem;
      font-size: 0.7rem;
    }
  }

  @media (max-width: 480px) {
    html {
      font-size: 14px;
    }

    .container {
      padding: 0 1rem;
    }

    .section {
      padding: 2.5rem 0;
    }

    .section-header {
      margin-bottom: 1.75rem;
    }

    .section-header h2 {
      font-size: clamp(1.35rem, 2vw, 1.75rem);
      margin-bottom: 0.25rem;
    }

    .section-header p {
      font-size: 0.85rem;
    }

    .ver-mas {
      font-size: 0.8rem;
    }

    .badge {
      padding: 0.15rem 0.45rem;
      font-size: 0.68rem;
    }

    .badge-destacado {
      padding: 0.2rem 0.6rem;
      font-size: 0.65rem;
    }
  }
</style>
