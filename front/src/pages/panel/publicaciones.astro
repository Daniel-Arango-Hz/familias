---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import CtaFooter from '../../components/CtaFooter.astro';

// @ts-ignore
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api';
---

<Layout title="Mis Libros – FamiliaLee" description="Libros publicados por el usuario.">
  <Header />
  <main>
    <section class="panel-hero">
      <div class="container panel-hero-inner">
        <div class="panel-avatar" aria-hidden="true">✍️</div>
        <div>
          <h1 class="panel-nombre">Mis Libros</h1>
          <p class="panel-email">Tus publicaciones en FamiliaLee</p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container panel-layout">
        <nav class="panel-nav" aria-label="Navegación del panel">
          <ul class="panel-nav-list">
            <li><a href="/panel/guardados" class="panel-nav-link">Guardados</a></li>
            <li><a href="/panel/publicaciones" class="panel-nav-link active">Publicaciones</a></li>
          </ul>
        </nav>

        <div class="panel-content">
          <div class="stats-row" id="published-stats" style="display: none;">
            <div class="stat-card">
              <strong id="stat-publicaciones">0</strong>
              <span>Publicaciones</span>
            </div>
            <div class="stat-card">
              <strong id="stat-descargas">0</strong>
              <span>Descargas</span>
            </div>
            <div class="stat-card">
              <strong id="stat-guardados">0</strong>
              <span>Guardados</span>
            </div>
          </div>

          <div class="section-header section-header-row">
            <div class="section-header">
              <h2>Libros Publicados</h2>
              <p id="published-count">Cargando...</p>
            </div>
            <a href="/subir-libro" class="btn-link">+ Publicar nuevo</a>
          </div>

          <div id="published-grid" class="panel-books-grid"></div>

          <div id="published-empty" class="empty-state" style="display: none;">
            <p>Aún no has publicado libros.</p>
            <a href="/subir-libro" class="btn-link">Subir primer libro</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <CtaFooter />
</Layout>

<script define:vars={{ apiUrl }}>
  // @ts-nocheck
  const API_URL = apiUrl;

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function renderPublishedBooks(libros) {
    const grid = document.getElementById('published-grid');
    const empty = document.getElementById('published-empty');
    const count = document.getElementById('published-count');
    const stats = document.getElementById('published-stats');
    const statPublicaciones = document.getElementById('stat-publicaciones');
    const statDescargas = document.getElementById('stat-descargas');
    const statGuardados = document.getElementById('stat-guardados');

    if (!grid || !empty || !count || !stats || !statPublicaciones || !statDescargas || !statGuardados) return;

    const totalPublicaciones = libros.length;
    const totalDescargas = libros.reduce((acc, libro) => acc + Number(libro.descargas_total || 0), 0);
    const totalGuardados = libros.reduce((acc, libro) => acc + Number(libro.guardados_total || 0), 0);

    statPublicaciones.textContent = totalPublicaciones.toLocaleString('es');
    statDescargas.textContent = totalDescargas.toLocaleString('es');
    statGuardados.textContent = totalGuardados.toLocaleString('es');
    stats.style.display = 'grid';

    count.textContent = `${libros.length} ${libros.length === 1 ? 'publicación' : 'publicaciones'}`;

    if (!libros.length) {
      grid.innerHTML = '';
      empty.style.display = 'block';
      return;
    }

    empty.style.display = 'none';

    grid.innerHTML = libros
      .map((libro) => {
        const portada = /^https?:\/\//i.test(libro.portada_icono || '')
          ? `<img class="book-cover-image" src="${escapeHtml(libro.portada_icono)}" alt="Portada de ${escapeHtml(libro.titulo)}" loading="lazy" />`
          : `<span class="book-icon">${escapeHtml(libro.portada_icono || '📖')}</span>`;

        const estado = libro.publicado ? 'Publicado' : 'Borrador';

        return `
          <article class="book-card">
            <a href="/libro/${encodeURIComponent(libro.slug)}" class="book-link">
              <div class="book-cover" style="background: ${escapeHtml(libro.portada_gradiente || 'linear-gradient(135deg,#00a8e8,#b82db5)')}">
                ${portada}
              </div>
              <div class="book-info">
                <h3>${escapeHtml(libro.titulo || 'Sin título')}</h3>
                <p>${escapeHtml(libro.autor_nombre || 'Autor')}</p>
                <small>${estado} · ⭐ ${Number(libro.rating_promedio || 0).toFixed(1)} · ⬇ ${Number(libro.descargas_total || 0).toLocaleString('es')} · ❤️ ${Number(libro.guardados_total || 0).toLocaleString('es')}</small>
              </div>
            </a>
          </article>
        `;
      })
      .join('');
  }

  async function loadPublishedBooks() {
    const token = localStorage.getItem('token');
    if (!token) {
      window.location.href = '/auth/login';
      return;
    }

    try {
      const res = await fetch(`${API_URL}/usuarios/publicaciones`, {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      if (res.status === 401) {
        window.location.href = '/auth/login';
        return;
      }

      if (!res.ok) throw new Error('No se pudieron cargar las publicaciones.');

      const data = await res.json();
      renderPublishedBooks(Array.isArray(data) ? data : []);
    } catch (error) {
      const count = document.getElementById('published-count');
      if (count) count.textContent = 'Error al cargar publicaciones';
      renderPublishedBooks([]);
    }
  }

  loadPublishedBooks();
</script>

<style>
  .panel-hero {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-border);
    padding: 2rem 0;
  }

  .panel-hero-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .panel-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-white);
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
  }

  .panel-nombre {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: var(--color-navy);
  }

  .panel-email {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .panel-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
  }

  .panel-nav {
    position: sticky;
    top: 80px;
  }

  .panel-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .panel-nav-link {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  .panel-nav-link:hover {
    background: var(--color-cream);
    color: var(--color-navy);
  }

  .panel-nav-link.active {
    background: var(--color-cream-dark);
    color: var(--color-navy);
    font-weight: 700;
  }

  .panel-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .stat-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  .stat-card strong {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.1;
  }

  .stat-card span {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .panel-books-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .book-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .book-link {
    display: block;
  }

  .book-cover {
    aspect-ratio: 3/4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .book-cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book-icon {
    font-size: 3rem;
    opacity: 0.45;
  }

  .book-info {
    padding: 0.9rem;
  }

  .book-info h3 {
    font-size: 1rem;
    color: var(--color-text);
    margin: 0 0 0.3rem;
  }

  .book-info p {
    font-size: 0.85rem;
    color: var(--color-primary-blue);
    margin: 0 0 0.2rem;
  }

  .book-info small {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .empty-state {
    background: var(--color-white);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.2rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  .btn-link {
    display: inline-block;
    margin-top: 0.2rem;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary-blue);
    color: var(--color-white);
    font-size: 0.88rem;
  }

  @media (max-width: 900px) {
    .panel-layout {
      grid-template-columns: 1fr;
    }

    .panel-nav {
      position: static;
    }

    .panel-nav-list {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .panel-books-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stats-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 520px) {
    .stats-row {
      grid-template-columns: 1fr;
    }

    .panel-books-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
