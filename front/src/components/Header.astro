---
const navLinks = [
  { label: "Biblioteca", href: "/#biblioteca" },
  { label: "Autores", href: "/#autores" },
  { label: "Galería Familiar", href: "/#galeria" },
  { label: "Recursos", href: "/#recursos" },
];
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="FamiliaLee inicio">
      <div class="logo-emoji">📚</div>
      <span class="logo-text">FamiliaLee</span>
    </a>

    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li><a href={link.href} class="nav-link">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="btn-icon" aria-label="Buscar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </button>
      
      <!-- Auth actions (mostrar si NO está logueado) -->
      <div id="auth-actions" class="auth-actions">
        <a href="/auth/login" class="btn-outline">
          🔑 Ingresar
        </a>
        <a href="/auth/registro" class="btn-primary">✨ Registrarse ✨</a>
      </div>

      <!-- User menu (mostrar si está logueado) -->
      <div id="user-menu" class="user-menu" style="display: none;">
        <button class="profile-btn" aria-label="Menú de usuario" aria-expanded="false">
          <div class="avatar">
            <span id="avatar-inicial">U</span>
          </div>
        </button>
        <div class="dropdown-menu">
          <a href="/perfil" class="menu-item">
            👤 Mi Perfil
          </a>
          <button id="logout-btn" class="menu-item logout">
            👋 Cerrar sesión
          </button>
        </div>
      </div>
    </div>

    <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" id="menu-toggle">
      <span></span><span></span><span></span>
    </button>

    <!-- Mobile Menu -->
    <nav class="mobile-menu" id="mobile-menu" aria-label="Menú principal móvil">
      <a href="/#biblioteca" class="mobile-menu-link">📚 Biblioteca</a>
      <a href="/#autores" class="mobile-menu-link">✍️ Autores</a>
      <a href="/#galeria" class="mobile-menu-link">🎨 Galería Familiar</a>
      <a href="/#recursos" class="mobile-menu-link">📖 Recursos</a>
      
      <!-- Mobile Auth Actions -->
      <div id="mobile-auth" class="mobile-auth-buttons">
        <a href="/auth/login" class="btn-outline">🔑 Ingresar</a>
        <a href="/auth/registro" class="btn-primary">✨ Registrar</a>
      </div>

      <!-- Mobile User Menu -->
      <div id="mobile-user-menu" style="display: none;">
        <a href="/perfil" class="mobile-menu-link">👤 Mi Perfil</a>
        <button id="mobile-logout-btn" class="mobile-menu-link logout">👋 Cerrar sesión</button>
      </div>
    </nav>

  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 64px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .logo-emoji {
    font-size: 1.8rem;
    display: flex;
    align-items: center;
  }

  .logo-text {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--color-navy-light), var(--color-primary-pink), var(--color-primary-blue));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav {
    flex: 1;
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-link {
    font-size: 0.95rem;
    color: var(--color-text);
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-navy);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .btn-icon:hover {
    background: var(--color-cream);
    color: var(--color-navy);
  }

  .auth-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-outline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    border: 2.5px solid var(--color-primary-blue);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-primary-blue);
    background: var(--color-white);
    cursor: pointer;
    transition: all 0.3s;
  }

  .btn-outline:hover {
    border-color: var(--color-primary-blue);
    background: var(--color-primary-blue);
    color: var(--color-white);
    transform: scale(1.05);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.5rem;
    background: linear-gradient(135deg, var(--color-primary-pink), var(--color-primary-red));
    color: var(--color-white);
    border: none;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: var(--shadow-md);
  }

  .btn-primary:hover {
    transform: scale(1.08);
    box-shadow: var(--shadow-lg);
  }

  /* User Menu */
  .user-menu {
    position: relative;
  }

  .profile-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary-blue), var(--color-primary-purple), var(--color-primary-pink));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    font-weight: 700;
    font-size: 1.1rem;
    box-shadow: var(--shadow-md);
    transition: transform 0.3s;
  }

  .profile-btn:hover .avatar {
    transform: scale(1.15);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    background: var(--color-white);
    border: 3px solid var(--color-primary-blue);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    min-width: 200px;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s;
    overflow: hidden;
  }

  .profile-btn[aria-expanded="true"] ~ .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .menu-item {
    display: block;
    width: 100%;
    padding: 0.8rem 1.2rem;
    border: none;
    background: none;
    text-align: left;
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    font-family: var(--font-sans);
  }

  .menu-item:hover {
    background: var(--color-cream);
    padding-left: 1.5rem;
  }

  .menu-item.logout {
    color: var(--color-primary-red);
    border-top: 3px solid var(--color-primary-blue);
    font-weight: 600;
  }

  .menu-item.logout:hover {
    background: rgba(255, 71, 87, 0.1);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
  }

  .menu-toggle span {
    display: block;
    width: 24px;
    height: 3px;
    background: var(--color-navy);
    border-radius: 2px;
    transition: all 0.3s;
  }

  /* Mobile Menu */
  .mobile-menu {
    display: none;
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    background: var(--color-white);
    border-bottom: 3px solid var(--color-primary-blue);
    flex-direction: column;
    gap: 0;
    z-index: 999;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
  }

  .mobile-menu.active {
    max-height: 600px;
  }

  .mobile-menu-link {
    display: block;
    padding: 1.2rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background 0.2s;
  }

  .mobile-menu-link:hover {
    background: var(--color-cream);
    padding-left: 1.8rem;
  }

  .mobile-menu-link.logout {
    color: var(--color-primary-red);
  }

  .mobile-auth-buttons {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    border-top: 3px solid var(--color-primary-blue);
  }

  .mobile-auth-buttons .btn-outline,
  .mobile-auth-buttons .btn-primary {
    flex: 1;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .logo-text {
      display: none;
    }

    .logo-emoji {
      font-size: 1.5rem;
    }

    .auth-actions {
      gap: 0.5rem;
    }

    .btn-outline,
    .btn-primary {
      padding: 0.6rem 0.9rem;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 768px) {
    .header-inner {
      height: 56px;
      gap: 0.75rem;
    }

    .logo {
      gap: 0.3rem;
    }

    .nav {
      display: none;
    }

    .btn-icon {
      width: 40px;
      height: 40px;
    }

    .auth-actions {
      display: none;
    }

    .user-menu {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-menu {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      height: 52px;
    }

    .logo-emoji {
      font-size: 1.3rem;
    }

    .btn-icon {
      width: 36px;
      height: 36px;
    }

    .menu-toggle {
      gap: 4px;
      padding: 0.35rem;
    }

    .menu-toggle span {
      width: 20px;
      height: 2px;
    }

    .mobile-menu-link {
      padding: 1rem 1.25rem;
      font-size: 0.95rem;
    }

    .mobile-auth-buttons {
      padding: 0.85rem 1.25rem;
      gap: 0.5rem;
    }
  }
</style>

<script>
  import { getUsuario, logout } from '../utils/api';

  // Mobile Menu Toggle
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  menuToggle?.addEventListener('click', () => {
    const isActive = mobileMenu?.classList.toggle('active');
    menuToggle?.setAttribute('aria-expanded', isActive ? 'true' : 'false');
  });

  // Close mobile menu when clicking a link
  document.querySelectorAll('.mobile-menu-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('active');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // Check if user is logged in
  const usuario = getUsuario();
  const authActions = document.getElementById('auth-actions');
  const userMenu = document.getElementById('user-menu');
  const mobileAuth = document.getElementById('mobile-auth');
  const mobileUserMenu = document.getElementById('mobile-user-menu');
  const logoutBtn = document.getElementById('logout-btn');
  const mobileLogoutBtn = document.getElementById('mobile-logout-btn');
  const avatarInicial = document.getElementById('avatar-inicial');
  const profileBtn = document.querySelector('.profile-btn') as HTMLButtonElement;

  if (usuario) {
    authActions!.style.display = 'none';
    userMenu!.style.display = 'block';
    mobileAuth!.style.display = 'none';
    mobileUserMenu!.style.display = 'block';

    const inicial = usuario.nombre?.charAt(0).toUpperCase() || 'U';
    avatarInicial!.textContent = inicial;

    // Toggle dropdown menu on profile button click
    profileBtn?.addEventListener('click', () => {
      const isExpanded = profileBtn.getAttribute('aria-expanded') === 'true';
      profileBtn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
    });

    // Close dropdown when clicking elsewhere
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!userMenu?.contains(target)) {
        profileBtn?.setAttribute('aria-expanded', 'false');
      }
    });

    logoutBtn?.addEventListener('click', () => {
      logout();
      window.location.reload();
    });

    mobileLogoutBtn?.addEventListener('click', () => {
      logout();
      window.location.reload();
    });
  } else {
    authActions!.style.display = 'flex';
    userMenu!.style.display = 'none';
    mobileAuth!.style.display = 'flex';
    mobileUserMenu!.style.display = 'none';
  }
</script>
