---
---

<section class="cta-section" id="cta-participacion-global">
  <div class="container">
    <div class="cta-box">
      <h2 class="cta-title">¿Tu familia quiere participar?</h2>
      <p class="cta-desc">
        Comparte fotos, videos y testimonios de tu hogar con la comunidad de CBI Personitas
Biblioteca
      </p>
      <a href="/auth/registro" class="cta-btn">
        Unirse ahora
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="FamiliaLee inicio">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="4" width="13" height="16" rx="2" stroke="#c8872a" stroke-width="2"/>
            <path d="M7 8h5M7 12h5M7 16h3" stroke="#c8872a" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M16 6l3 2-3 2V6z" fill="#0d2240"/>
          </svg>
          <span>CBI Personitas Biblioteca</span>
        </a>
        <p class="footer-desc">
          Una comunidad de familias y autores que comparten el amor por la lectura y la union de las familias.
        </p>
        <blockquote class="footer-verse">
          "Instruye al niño en su camino, y aun cuando fuere viejo no se apartará de él." — <cite>Proverbios 22:6</cite>
        </blockquote>
      </div>

      <nav class="footer-nav" aria-label="Explorar">
        <h3>EXPLORAR</h3>
        <ul>
          <li><a href="/biblioteca">Biblioteca</a></li>
          <li><a href="/autores">Autores</a></li>
          <li><a href="/galeria">Galería Familiar</a></li>
          <li><a href="/recursos">Recursos</a></li>
        </ul>
      </nav>

      <nav class="footer-nav" aria-label="Cuenta">
        <h3>CUENTA</h3>
        <ul>
          <li><a href="/auth/registro">Registrarse</a></li>
          <li><a href="/auth/login">Ingresar</a></li>
          <li><a href="/panel/publicaciones">Mi Panel</a></li>
          <li id="footer-admin-link" hidden><a href="/admin">Administrador</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 CBI Personitas Biblioteca. Todos los derechos reservados.</p>
      <p class="footer-heart">Hecho con <span aria-label="amor">♥</span> para las familias</p>
    </div>
  </div>
</footer>

<script type="module">
  const ctaParticipacion = document.getElementById('cta-participacion-global');
  const footerAdminLink = document.getElementById('footer-admin-link');
  const usuarioRaw = localStorage.getItem('usuario');
  const hasSession = Boolean(localStorage.getItem('token') || usuarioRaw);

  if (hasSession && ctaParticipacion) {
    ctaParticipacion.style.display = 'none';
  }

  if (footerAdminLink) {
    if (usuarioRaw && localStorage.getItem('token')) {
      try {
        const usuario = JSON.parse(usuarioRaw);
        footerAdminLink.hidden = usuario?.tipo !== 'admin';
      } catch (err) {
        console.error('Error leyendo usuario en footer:', err);
        footerAdminLink.hidden = true;
      }
    } else {
      footerAdminLink.hidden = true;
    }
  }
</script>

<style>
  .cta-section {
    background: radial-gradient(circle at top left, rgba(255, 124, 60, 0.12), transparent 32%),
      #fff8ef;
    padding: 3rem 0 1rem;
  }

  .cta-box {
    background: linear-gradient(135deg, #ffe9da, #fff6f0);
    border: 1px solid rgba(255, 108, 63, 0.16);
    border-radius: 2rem;
    padding: 3rem 2rem;
    text-align: center;
    display: grid;
    gap: 1rem;
  }

  .cta-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    color: #cd5a1d;
    margin: 0;
  }

  .cta-desc {
    font-size: 1rem;
    color: #5d5046;
    line-height: 1.8;
    max-width: 560px;
    margin: 0 auto;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    background: #ff6c3f;
    color: #fff;
    border-radius: 999px;
    font-size: 0.96rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
    box-shadow: 0 16px 36px rgba(255, 108, 63, 0.15);
  }

  .cta-btn:hover {
    transform: translateY(-2px);
    background: #e5572f;
    box-shadow: 0 22px 42px rgba(255, 108, 63, 0.2);
  }

  .footer {
    background: #fff;
    border-top: 1px solid rgba(54, 50, 47, 0.08);
    padding: 3.5rem 0 1.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 2.2fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
  }

  .footer-logo span {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: #2e2b27;
  }

  .footer-brand {
    display: grid;
    gap: 0.75rem;
  }

  .footer-desc {
    font-size: 0.95rem;
    color: #5d5046;
    line-height: 1.7;
    max-width: 360px;
  }

  .footer-verse {
    font-size: 0.92rem;
    font-style: italic;
    color: #5d5046;
    border-left: 3px solid #fbbf7d;
    padding-left: 0.9rem;
    margin-top: 0.5rem;
    line-height: 1.7;
  }

  .footer-nav h3 {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #8c7b6a;
    margin-bottom: 1rem;
  }

  .footer-nav ul {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
  }

  .footer-nav a {
    font-size: 0.95rem;
    color: #4e4842;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: #cd5a1d;
  }

  .footer-bottom {
    border-top: 1px solid rgba(54, 50, 47, 0.08);
    padding: 1.5rem 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: #7b6c5d;
  }

  .footer-heart {
    color: #7b6c5d;
  }

  .footer-heart span {
    color: #ff6c3f;
  }

  @media (max-width: 820px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
