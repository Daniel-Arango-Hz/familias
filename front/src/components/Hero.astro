---
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3" y="4" width="13" height="16" rx="2" stroke="#c8872a" stroke-width="2"/>
        <path d="M7 8h5M7 12h5M7 16h3" stroke="#c8872a" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      Biblioteca Digital para Familias
    </div>

    <h1 class="hero-title">
      Recursos que<br />
      <span class="hero-title-highlight">nutren</span> la unión de las familiar
    </h1>

    <p class="hero-desc">
      Libros, cuentos, guías y recursos educativos creados por autores y familias para
      fortalecer el hogar.
    </p>

    <form class="hero-search" action="/buscar" method="get" role="search">
      <label for="hero-search-input" class="sr-only">Buscar contenido</label>
      <svg class="hero-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        id="hero-search-input"
        type="search"
        name="q"
        class="hero-search-input"
        placeholder="Buscar libros, autores, categorías..."
        autocomplete="off"
      />
      <button type="submit" class="hero-search-btn">Buscar</button>
    </form>

    <div class="hero-actions">
      <a href="#biblioteca" class="btn-gold">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="4" width="13" height="16" rx="2" stroke="currentColor" stroke-width="2"/>
          <path d="M7 8h5M7 12h5M7 16h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Explorar biblioteca
      </a>
      <a href="/subir-libro" class="btn-ghost js-require-login-upload">
        Publicar contenido
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="hero-stats">
      <div class="hero-stat">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3" y="4" width="13" height="16" rx="2"/>
          <path d="M7 8h5M7 12h5M7 16h3" stroke-linecap="round"/>
        </svg>
        <div>
          <strong>200+</strong>
          <span>Libros disponibles</span>
        </div>
      </div>
      <div class="hero-stat">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        <div>
          <strong>50+</strong>
          <span>Autores activos</span>
        </div>
      </div>
      <div class="hero-stat">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <div>
          <strong>12.000+</strong>
          <span>Descargas totales</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const publishBtn = document.querySelector('.js-require-login-upload');

    publishBtn?.addEventListener('click', (e) => {
      const token = localStorage.getItem('token');
      if (token) return;

      e.preventDefault();

      const modal = document.getElementById('loginModalOverlay');
      const titleEl = document.getElementById('modalTitle');
      const msgEl = document.getElementById('modalMessage');

      if (titleEl) titleEl.textContent = 'Inicio de sesión requerido';
      if (msgEl) msgEl.textContent = 'Debes iniciar sesión para publicar contenido.';
      if (modal) modal.classList.add('active');
    });
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    border: 0;
  }

  .hero {
    background-color: var(--color-navy);
    color: var(--color-white);
    padding: 6rem 0 5rem;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.75rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 100px;
    font-size: 0.85rem;
    color: rgba(255,255,255,0.85);
    background: rgba(255,255,255,0.06);
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-white);
  }

  .hero-title-highlight {
    color: var(--color-gold-light);
    font-style: normal;
  }

  .hero-desc {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: rgba(255,255,255,0.7);
    max-width: 580px;
    line-height: 1.65;
  }

  .hero-search {
    display: flex;
    align-items: center;
    background: rgba(255,255,255,0.95);
    border-radius: var(--radius-md);
    width: 100%;
    max-width: 560px;
    overflow: hidden;
    gap: 0;
  }

  .hero-search-icon {
    flex-shrink: 0;
    margin-left: 1rem;
    color: var(--color-text-muted);
  }

  .hero-search-input {
    flex: 1;
    border: none;
    outline: none;
    padding: 0.85rem 0.75rem;
    font-size: 0.95rem;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-sans);
  }

  .hero-search-input::placeholder {
    color: var(--color-text-muted);
  }

  .hero-search-btn {
    flex-shrink: 0;
    background: var(--color-gold);
    color: var(--color-white);
    padding: 0.85rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    transition: background 0.2s;
    cursor: pointer;
    border: none;
    font-family: var(--font-sans);
  }

  .hero-search-btn:hover {
    background: var(--color-gold-light);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-gold {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-gold);
    color: var(--color-white);
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 600;
    transition: background 0.2s;
  }

  .btn-gold:hover {
    background: var(--color-gold-light);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid rgba(255,255,255,0.3);
    color: var(--color-white);
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 500;
    transition: border-color 0.2s, background 0.2s;
  }

  .btn-ghost:hover {
    border-color: rgba(255,255,255,0.6);
    background: rgba(255,255,255,0.08);
  }

  .hero-stats {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .hero-stat {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: rgba(255,255,255,0.7);
  }

  .hero-stat div {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    text-align: left;
  }

  .hero-stat strong {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-white);
  }

  .hero-stat span {
    font-size: 0.8rem;
  }

  @media (max-width: 480px) {
    .hero {
      padding: 4rem 0 3.5rem;
    }

    .hero-stats {
      gap: 1.5rem;
    }
  }
</style>
